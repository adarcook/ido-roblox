local Rules = require('../src/Rules')
assert(require('@lune/fs').readFile('VERSION'):gsub('%s+$','')==Rules.VERSION,'VERSION and HUD disagree')
assert(Rules.ceiling==nil, 'Power must never impose an altitude cap')
assert(Rules.speed(25,0,false)>Rules.speed(1,0,false))
assert(Rules.speed(10,0,true)<Rules.speed(10,0,false))
assert(Rules.tier(2)==0 and Rules.tier(3)==1 and Rules.tier(100)==3)
assert(not Rules.canSteal(1,1,true,true,3), 'Double carry allowed')
assert(not Rules.canSteal(1,1,false,false,3), 'Unavailable block allowed')
assert(not Rules.canSteal(1,1,false,true,30), 'Remote theft allowed')
assert(Rules.canSteal(1,200,false,true,15), 'Power must not gate theft or height')
assert(#Rules.COLLECTIBLES==12 and #Rules.ZONES==4)
for i,zone in Rules.ZONES do
 assert(Rules.inZone(zone,0,zone.start))
 assert(not Rules.inZone(zone,0,zone.finish), 'Biome seam overlaps')
 assert(not Rules.inZone(zone,-90,zone.start+1))
 assert(not Rules.inZone(zone,90,zone.start+1))
 assert(Rules.guardianCanCatch(zone,0,zone.start+10,0,zone.start+12,2))
 assert(Rules.guardianCanCatch(zone,0,zone.finish,0,zone.finish-2,2),'Pursuit must catch outside territory')
 assert(not Rules.guardianCanReclaim(zone,0,zone.finish),'Reclaimed outside territory')
 assert(Rules.guardianCanCatch(zone,0,zone.start+1,0,zone.start-1,2))
 assert(Rules.guardianCanReclaim(zone,0,zone.start+1))
 assert(not Rules.guardianCanReclaim(zone,91,zone.start+1))
 assert(not Rules.guardianCanCatch(zone,0,zone.start+10,0,zone.start+12,8))
 local tree=Rules.TREES[i]
 assert(tree.z>zone.start and tree.z<zone.finish)
 assert(Rules.speed(1,0,true)>tree.speed,'New player cannot escape')
 local p,c,d=Rules.reward(tree,199,0,0)
 assert(p==200 and c==tree.coins and d==1)
end
local step=1
assert(Rules.nextTutorial(step,'deliver')==1, 'Tutorial skipped learning steps')
for _,event in {'train','fly','steal','escape','deliver'} do step=Rules.nextTutorial(step,event) end
assert(step==6 and Rules.nextTutorial(6,'train')==6, 'Completed tutorial restarted')
local earned=table.create(12,0); earned[2]=1; earned[12]=3
local first=Rules.collectionMerge({},earned,{})
assert(first[2]==1 and first[12]==3 and first[1]==0,'Lost collectible color or biome')
local retry=Rules.collectionMerge(first,earned,earned)
assert(retry[2]==1 and retry[12]==3,'Save retry duplicated collection')
local advanced=table.clone(earned); advanced[2]=2
local nextSave=Rules.collectionMerge(retry,advanced,earned)
assert(nextSave[2]==2 and nextSave[12]==3,'Incremental save lost collection')
local concurrent=Rules.collectionMerge(nextSave,{1},{})
assert(concurrent[1]==1 and concurrent[2]==2,'Concurrent session overwrote collection')
print('v7 rules passed: free altitude/theft, speed, 12 collectibles, cross-border pursuit and territorial reclaim, tutorial and idempotent collection saves')
